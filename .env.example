# Bu dosyayı ".env" olarak kopyalayıp kendi bilgilerinle doldur.
# .env dosyasını ASLA kimseyle paylaşma veya git'e ekleme.
# Sadece kullandığın pazaryerlerinin bilgilerini doldurman yeterli —
# boş bırakılan bir platform panelde otomatik olarak pasif görünür.

PORT=3000

# Panele giriş şifresi (tarayıcıdan panele erişirken sorulur)
PANEL_PASSWORD=degistir-bu-sifreyi

# Ne sıklıkla otomatik yenilensin (dakika)
REFRESH_INTERVAL_MINUTES=15

# ------------------------------
# HEPSİBURADA (Merchant Panel > Entegrasyon Bilgileri)
# ------------------------------
HB_MERCHANT_ID=
HB_USERNAME=
HB_PASSWORD=
HB_ENV=live

# ------------------------------
# TRENDYOL (Satıcı Panel > Hesap Bilgilerim > Entegrasyon Bilgileri)
# ------------------------------
TY_SELLER_ID=
TY_API_KEY=
TY_API_SECRET=
TY_ENV=live

# ------------------------------
# N11 (Mağaza Yönetim Paneli > Hesabım > Api Hesapları)
# ------------------------------
N11_APP_KEY=
N11_APP_SECRET=

# ------------------------------
# ÇİÇEKSEPETİ (Bayi paneli > destek talebiyle alınan API Key)
# NOT: Bu entegrasyonun uç noktaları henüz tam doğrulanamadı,
# README'deki ilgili bölüme bak.
# ------------------------------
CS_API_KEY=
CS_ENV=live
